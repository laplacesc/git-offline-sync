{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitOfflineSync",
  "version": "2.0.4",
  "identifier": "com.jxwu.gitofflinesync",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git 离线同步",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "shortDescription": "用 git bundle 在离线内网与外网之间同步仓库"
  },
  "mainBinaryName": "git-offline-sync",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2N0M1Qzk5RDlEQkU5RDUKUldUVjZkdlptVng4MWhna0g0cXU2eTJrWTJZQmR4L3ptSlFuaHoyOER0aXdKTWFUUlBKYTRDREcK",
      "endpoints": [
        "https://github.com/laplacesc/git-offline-sync/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
